<component type="desktop-application">
  <id>io.github.labj1987.SteamPunk</id>
  <name>SteamPunk</name>
  <summary>Launch Windows game trainers through Proton against a running Steam game</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <description>
    <p>
      Runs a Windows trainer .exe (e.g. a FLiNG trainer) directly against a
      currently running Steam game's existing Proton wine session, so the
      trainer's wine client joins the game's wineserver instead of starting
      its own. The Proton build to use is detected from the actual running
      wineserver process, not from potentially stale compatdata metadata.
    </p>
  </description>
  <launchable type="desktop-id">steampunk.desktop</launchable>
